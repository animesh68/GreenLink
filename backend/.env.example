# GreenLink Delhi - Backend Environment Configuration Example
# Copy this file to .env in backend/ for local custom overrides

# Server host and port
HOST=127.0.0.1
PORT=8000
RELOAD=true

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
