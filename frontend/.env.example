# GreenLink Delhi - Frontend Configuration

# Basemap Style for MapLibre GL JS
# Default: OpenFreeMap Positron (vector basemap, light neutral theme, free & no API key required)
# Documentation & Status: https://openfreemap.org/
VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron

# Alternative free vector styles from OpenFreeMap:
# VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/liberty
# VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/bright

# If using Stadia Maps (requires personal/org API key):
# VITE_BASEMAP_STYLE=https://tiles.stadiamaps.com/styles/alidade_smooth.json?api_key=YOUR_STADIA_KEY

# If using CARTO Basemaps (requires CARTO API key):
# VITE_BASEMAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json?api_key=YOUR_CARTO_KEY
